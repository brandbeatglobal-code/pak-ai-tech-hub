# Postgres connection string.
# Production/preview: the Neon store created from the Vercel dashboard injects
# this automatically. Local development: point it at your own Postgres.
DATABASE_URL="postgresql://user:password@host:5432/database"

# Signing secret for Auth.js session tokens. Generate with:
#   npx auth secret
# or: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Contact form delivery (Resend). Without both, /contact still renders and
# validates, but a submission returns the error state with the mailto fallback.
RESEND_API_KEY="re_..."
# Must be an address on a domain VERIFIED in the Resend account.
CONTACT_FROM_EMAIL="PAKAI TechHub <noreply@yourverifieddomain.com>"
