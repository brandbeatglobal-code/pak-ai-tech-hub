# Postgres connection string.
# Production/preview: the Neon store created from the Vercel dashboard injects
# this automatically. Local development: point it at your own Postgres.
DATABASE_URL="postgresql://user:password@host:5432/database"

# Signing secret for Auth.js session tokens. Generate with:
#   npx auth secret
# or: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Email delivery (Resend), used by two things:
#   - the contact form. Without both variables /contact still renders and
#     validates, but a submission returns the error state with the mailto
#     fallback.
#   - the admin review queue's decision emails (lib/review-email.ts). Without
#     both, decisions still save and the admin is told no email was sent.
RESEND_API_KEY="re_..."
# Must be an address on a domain VERIFIED in the Resend account. pakaitechub.com
# is verified there, so a noreply@ on it is the sender to use. The name says
# "contact" for historical reasons; it is the site's one no-reply sender and
# the review emails use it too. Where mail goes TO is not an env var: the
# contact form delivers to `contactEmail` in content/site-copy.ts, and review
# emails go to the applicant's or provider's own account address.
CONTACT_FROM_EMAIL="PAKAI TechHub <noreply@pakaitechub.com>"

# "Continue with Google" on /login and /sign-up (auth.ts). OPTIONAL: leave
# either one unset and Google sign-in is off — the provider is not registered
# and neither page shows the button. Email + password works either way.
#
# Create an OAuth client ID ("Web application") in Google Cloud Console, and
# register this exact redirect URI on it for every origin that serves the app:
#   {origin}/api/auth/callback/google
# e.g. http://localhost:3000/api/auth/callback/google for local development.
# Empty here on purpose: a copied placeholder would switch the button on with
# credentials that can only fail.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
